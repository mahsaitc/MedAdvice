
@{
    ViewData["Title"] = "PurchaseCartManagement";
    Layout = "~/Views/shared/_Layout.cshtml";
}

@model Purchasecart
<div class="page-title-area item-bg3">
    <div class="container">
        <h1>PurchaseCart</h1>
        
    </div>
</div>
<section class="cart-area ptb-120">
    <div class="container">
        <div class="row">
            <div class="col-lg-12 col-md-12">
                <form>
                    <div class="cart-table table-responsive">
                        <table class="table table-bordered">
                            <thead>
                                <tr>
                                    <th scope="col">Picture</th>
                                    <th scope="col">Product</th>
                                    <th scope="col">Price</th>
                                    <th scope="col">Count</th>
                                    <th scope="col">TotalPrice</th>
                                    <th scope="col">Delete</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var item in Model.PurchaseCartItems)
                                {
                                    <tr>
                                        <td class="product-thumbnail">
                                            <a href="#">
                                                <img width="80" src="@($"data:image/jpeg;base64,{Convert.ToBase64String(item.Product.productImages[0].img)}")">
                                            </a>
                                        </td>

                                        <td class="product-name">
                                            <a href="#">@item.Product.englishname</a>
                                        </td>

                                        <td class="product-price">
                                            <span class="unit-amount">@($"{item.Product.price:0,0}")$</span>
                                        </td>

                                        <td class="product-quantity">
                                            <input value="@item.count" type="number" id="txtcount"
                                                   purchaseitemid="@item.Id">
                                        </td>

                                        <td class="product-subtotal">
                                            <span class="subtotal-amount">@($"{item.Product.price:0,0}") $</span>
                                        </td>

                                        <td class="product-remove">
                                            <a href="#" id="btnremovefrompurchasecart"
                                               purchaseitemid="@item.Id"><i class="btn btn-close"></i></a>
                                        </td>
                                    </tr>
                                }


                            </tbody>
                        </table>
                    </div>

                    <div class="cart-buttons">
                        <div class="row h-100 justify-content-center align-items-center">
                            <div class="col-lg-7 col-md-7">
                                <div class="coupon-box">
                                    <input type="text" class="form-control" placeholder="Discount Code">
                                    <button type="submit">Enter your Discount Code</button>
                                </div>
                            </div>

                            <div class="col-lg-5 col-md-5 text-right">
                                <a href="#" class="btn btn-primary">Update PurchaseCart</a>
                            </div>
                        </div>
                    </div>

                    <div class="cart-totals">
                        <h3>Total</h3>

                        <ul>
                            <li>Total Price: <span id="spanTotalPrice"> @ViewData["totalprice"]$ </span></li>
                           
                        </ul>
                        <a href="#" class="btn btn-primary">Final review</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>
@Html.AntiForgeryToken()
<script>
    function antiForgeryToken() {
        return document.querySelector('input[name="__RequestVerificationToken"]').value
    }
</script>
<script>
    $(() => {
        $(txtcount).change(function () {
            let count = parseInt($(this).val())
            let purchaseitemid = $(this).attr('purchaseitemid')
            if (count == 0) {
                $(this).val(1)
                return
            } else {
                $.post('/customer/customer/ChangeCountPurchaseItem',
                    { count: count, purchaseitemid: purchaseitemid,
                      __RequestVerificationToken: antiForgeryToken() }, x => {
                        if (x.status === true) {
                            $(spanTotalPrice).html(`  ${x.totalprice} $`);
                            $(btn).parents('tr').remove()
                        }
                    })
            }
        })

        $(btnremovefrompurchasecart).click(function (event) {
            event.preventDefault()
            let id = $(this).attr('purchaseitemid')
            let btn = $(this)
            $.post('/Customer/Customer/RemoveFromPurchaseCart',
                { purchaseitemid: id, __RequestVerificationToken: antiForgeryToken() }, x => {
                if (x.status === true) {
                    $(spanTotalPrice).html(`${x.totalprice}$`);
                    $(btn).parents('tr').remove()
                }
            })
        })
    })
</script>

