@model AdminResetPasswordViewModel
@{
    ViewData["Title"] = "تغییر رمز عبور کاربر";
}
<style>
    form {
        padding: 20px;
    }

    label {
        color: green
    }
</style>

<div class="container">
    <h1>تغییر رمز عبور کاربر</h1>

    <form asp-area="admin" asp-controller="User" asp-action="ResetPasswordConfirm" method="post">

        <div asp-validation-summary="All" class="text-danger"></div>
        <input type="hidden" asp-for="UserId" />

        <div class="row">
            <div class="col-md-6">
                <label>نام کاربری</label>
                <input class="form-control" value="@Model.UserName" readonly />
            </div>
        </div>

        <div class="row">
            <div class="col-md-6">
                <label>رمز عبور جدید</label>
                <input type="password" class="form-control" asp-for="NewPassword" />
                <span asp-validation-for="NewPassword"></span>
            </div>
            <div class="col-md-6">
                <label>تکرار رمز عبور جدید</label>
                <input type="password" class="form-control" asp-for="ConfirmPassword" />
                <span asp-validation-for="ConfirmPassword"></span>
            </div>
        </div>

        <div class="row">
            <div class="col-md-12">
                <p>
                    رمز عبور باید حداقل ۸ کاراکتر باشد و شامل حرف بزرگ، حرف کوچک، عدد
                    و کاراکتر غیرحرفی باشد.
                </p>
                <button type="submit" class="btn btn-warning">تغییر رمز عبور</button>
                <a asp-area="admin" asp-controller="User" asp-action="Details" asp-route-id="@Model.UserId"
                   class="btn btn-default">انصراف</a>
            </div>
        </div>
    </form>
</div>
