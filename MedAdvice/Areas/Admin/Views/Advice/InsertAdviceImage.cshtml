
@{
    ViewData["Title"] = "InsertAdviceImage";
}
@{
    Advice advice = ViewData["Advice"] as Advice;
}
@model AdviceImageViewModel
<h1>InsertAdviceImage</h1>
<style>
    form {
        padding: 20px;
    }

    label {
        color: green
    }
</style>
<div class="container">
    <form asp-area="admin" asp-controller="Advice" asp-action="InsertAdviceImageConfirm"
          method="post" enctype="multipart/form-data">
        <div class="row">
            <div class="col-md-6">
                <label> عنوان توصیه</label>
                <input class="form-control" value="@advice.AdviceTitle" />

            </div>
            <div class="col-md-6">
                <label>تاریخ</label>
                <input class="form-control" value="@advice.AdviceDate" />

            </div>
        </div>
     
        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    <label for="exampleInputFile">تصویر توصیه</label>
                    <div class="input-group">
                        <div class="custom-file">
                            <input id="file1" type="file" multiple class="custom-file-input" asp-for="AdviceImage">
                            <label class="custom-file-label" for="exampleInputFile">انتخاب فایل</label>
                        </div>

                        
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <label> عنوان فایل عکس</label>
                <input class="form-control" asp-for="AdviceImageTitle" />
            </div>

        </div>
        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    <div id="divimages">
                        <img id="imgpreview" width="100" />
                    </div>
                </div>
            </div>
            <div class="col-md-6">
            </div>
        </div>

        <button class="btn btn-success">ثبت تصویر </button>
        <button class="btn btn-success">
            <a asp-area="Admin" asp-action="InsertAdvice" asp-controller="advice" class="text-white">ورود توصیه جدید</a>
        </button>
    </form>


</div>
<script>
    $(() => {
        $(file1).change(function (event) {
            $(divimages).html('')//pak mikonad
            for (var x of event.target.files)//فایلهای عکس انتخاب شده را تک تک بخوان
            {
                //event.target.files[0].size
                var parts = x.name.split('.')
                if (parts[1].toLowerCase() === "jpg" || parts[1].toLowerCase() === "png" || parts[1].toLowerCase() === "jpeg") {
                    var reader = new FileReader()
                    reader.readAsDataURL(x)
                    reader.onloadend = x => {
                        $(divimages).append(`<img style="margin:5px" class='rounded-pill' width='100' src='${x.target.result}'/>`)
                    }
                } else {
                    alert('فرمت فایل تصویر مناسب نمی باشد')
                }
            }
        })
    })
</script>

