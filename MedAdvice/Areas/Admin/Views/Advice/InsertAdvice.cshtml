
@{
    ViewData["Title"] = "InsertAdvice";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}
@model AdviceViewmodel
@{
    var AdviceCategories = ViewData["AdviceCategory"] as List<AdviceCategory>;
}


<h1>InsertAdvice</h1>
<style>
    form {
        padding: 20px;
    }

    label {
        color: green
    }
</style>
<div class="container">
    <form asp-area="Admin" asp-controller="Advice" asp-action="InsertAdviceConfirm" method="post" enctype="multipart/form-data">
        <div class="row">
            <div class="col-md-6">
                <label> عنوان توصیه پزشکی</label>
                <input class="form-control" asp-for="AdviceTitle" />
                <span asp-validation-for="AdviceTitle"></span>
            </div>
            <div class="col-md-6">
                <label>تاریخ توصیه پزشکی</label>
                <input type="text" class="form-control ltr" data-inputmask="'alias': 'yyyy/mm/dd'" data-mask="yyyy/mm/dd" asp-for="AdviceDate">
                <span asp-validation-for="AdviceDate"></span>
            </div>
        </div>
        <div class="row">
            <div class="col-md-6">
                <label> گروه بندی توصیه پزشکی</label>
                <select class="form-control" id="ddlAdviceCategoriesFirst">
                    <option></option>
                    @foreach (var item in AdviceCategories)
                    {
                        <option value="@item.Id">@item.AdviceCategoryname</option>
                    }
                </select>
                <label>دسته بندی توصیه پزشکی</label>
                <select class="form-control" id="ddlAdviceCategoriesSecond" asp-for="AdviceCategoryId">
                </select>

            </div>
            <div class="col-md-6">

                </div>

        </div>

        <div class="form-group">
            <label> خلاصه متن</label>
            <textarea asp-for="AdviceBriefText" class="form-control" rows="3" style="direction:ltr"></textarea>
            <span asp-validation-for="AdviceBriefText"></span>
        </div>


        <div class="row">
            <div class="col-md-12">
                <div class="card card-info card-outline">
                    <div class="card-header">
                        <h3 class="card-title">

                            <small>متن اصلی توصیه پزشکی</small>
                        </h3>
                        <!-- tools box -->
                        <div class="card-tools">
                            <button type="button" class="btn btn-tool btn-sm" data-widget="collapse" data-toggle="tooltip" title="" data-original-title="Collapse">
                                <i class="fa fa-minus"></i>
                            </button>
                           
                        </div>
                        <!-- /. tools -->
                    </div>
                    <!-- /.card-header -->
                    <div>

                        <textarea id="txt1" asp-for="AdviceText"></textarea>
                        <script>
                            CKEDITOR.replace('txt1', {
                            })
                        </script>
                    </div>
                </div>

            </div>

        </div>
        <div>

        </div>
        <div class="input-group">
            <div class="custom-file">
                <input type="file" class="custom-file-input" asp-for="AdviceHeaderImage" id="headerfile">
                <label class="custom-file-label" for="exampleInputFile">انتخاب فایل تصویر</label>
            </div>
            <div class="input-group-append">
                <span class="input-group-text" id="">Upload</span>
            </div>
        </div>
        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    <div id="divimages">
                        <img id="headerimgpreview" width="400" />
                    </div>
                </div>
            </div>

        </div>



        <button class="btn btn-success">ثبت</button>
    </form>

</div>



<script>
    $(() => {

        $(ddlAdviceCategoriesFirst).change(function (event) {
            let AdviceCategoryIdFirst = $(event.target).val()
            $.get('/admin/advice/GetAdviceCategories', { AdvCategoryId: AdviceCategoryIdFirst }, value => {
                /*alert(JSON.stringify(value))*/
                $(ddlAdviceCategoriesSecond).html('<option></option>')

                for (let x of value) {
                    
                    $(ddlAdviceCategoriesSecond).append(`<option value='${x.id}'>${x.adviceCategoryname}</option>`)
                }
            })
        })


        $(headerfile).change(function (event) {
            var reader = new FileReader()
            reader.readAsDataURL(event.target.files[0])
            reader.onloadend = x => {
                $(headerimgpreview).attr('src', x.target.result)
            }
        })
    })
</script>





