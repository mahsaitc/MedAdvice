    @inject UserManager<ApplicationUser> usermanager

    <div id="divtimer" style="color:red"></div>
    @{
        string lockedoutdate = ViewContext.HttpContext.Session.GetString("lockedoutdate");
    }
    @if (lockedoutdate != null) //TempData["islockedout"] != null && (bool)TempData["islockedout"] == true)
    {
        DateTime _lockedoutdate = DateTime.Parse(lockedoutdate);

        int seconds = (int)DateTime.Now.Subtract(_lockedoutdate).TotalSeconds;
        if (seconds < 80)
        {
            <script>
                $(() => {
                    let counter = 80 - @seconds ;
                    let timer1 = setInterval(() => {
                        if (counter == -1) {
                            clearInterval(timer1)
                            $(divtimer).html('')
                        } else
                            $(divtimer).html(` time of your account inactivity is: ${counter--}`)
                    }, 1000)
                })
            </script>
        }
        else
        {
            ViewContext.HttpContext.Session.Remove("lockedoutdate");
        }
    }

