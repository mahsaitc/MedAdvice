@model MedAdvice.Models.HomepageContent

<div class="site-announcement bg-color">
    <div class="container">
        <div class="row align-items-center ptb-20">
            <div class="col-lg-9">
                <p>@Model.AnnouncementText</p>
            </div>
            @if (string.IsNullOrWhiteSpace(Model.AnnouncementCtaText) == false
                 && string.IsNullOrWhiteSpace(Model.AnnouncementCtaUrl) == false)
            {
                <div class="col-lg-3 text-right">
                    <a href="@Model.AnnouncementCtaUrl" class="btn default-btn">@Model.AnnouncementCtaText</a>
                </div>
            }
        </div>
    </div>
</div>
