
@model List<DoctorSpaciality>
<div class="page-banner-area bg-2">
    <div class="d-table">
        <div class="d-table-cell">
            <div class="container">
                <div class="page-content">
                    <h2>Doctor Groups</h2>
                    <ul>
                        <li><a href="index.html">Home</a></li>
                        <li>Doctor Groups</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="blog-area blog-area-two ptb-100">
    <div class="container">


        <div class="row">
            @foreach (var item in Model)
            {
                <div class="col-lg-4 col-md-6">
                    <div class="blog-card">
                        <a href="blog-details.html">
                            <img src=@($"data:img/jpeg;base64,{Convert.ToBase64String(item.DrSpacialityPicture)}")>
                        </a>
                        <div class="b-card-text">
                            <span>September 25, 2021 <a href="#"></a></span>
                            <span class="t-right"><i class="bx bx-user"></i> 200K</span>
                            <h3><a asp-action="ViewDrSpacialities" asp-controller="home" asp-route-id="@item.Id">@item.SpacialityTitle</a></h3>
                            <div class="view-more">
                                <a asp-action="ViewDrSpacialities" asp-controller="home" asp-route-id="@item.Id" class="view-more-btn" value="@item.Id">
                                    Read more
                                    <span></span>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }

          
        </div>


    </div>
</div>


