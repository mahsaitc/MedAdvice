@model MedAdvice.viewmodel.HomepageViewModel

@foreach (var section in Model.Sections)
{
    switch (section.SectionKey)
    {
        case "banner":
            <partial name="_SectionBanner" model="Model" />
            break;
        case "featured":
            <partial name="_SectionFeatured" model="Model" />
            break;
        case "about":
            <partial name="_SectionAbout" />
            break;
        case "appointment":
            <partial name="_SectionAppointment" />
            break;
        case "services":
            <partial name="_SectionServices" />
            break;
        case "choice":
            <partial name="_SectionChoice" />
            break;
        case "special":
            <partial name="_SectionSpecial" />
            break;
        case "work":
            <partial name="_SectionWork" />
            break;
    }
}
