
@model List<AdviceCategory>
<div class="page-banner-area bg-2">
    <div class="d-table">
        <div class="d-table-cell">
            <div class="container">
                <div class="page-content">
                    <h2>Madical Advice Spatialities</h2>
                    <ul>
                        <li><a href="index.html">Home</a></li>
                        <li>Spatialities</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="services-area ptb-100">
    <div class="container">
        <div class="section-title-one">
            <span>Spaciality of Emergency Conditions</span>
            <h2>Spaciality of Emergency Conditions</h2>
        </div>
        <div class="row">
            @foreach (var item in Model)
            {
                <div class="col-lg-3 col-sm-6">
                    <div class="service-card">
                        <img src=@($"data:img/jpeg;base64,{Convert.ToBase64String(item.AdviceCategoryPicture)}")>
                        @*<i class="bx bx-strikethrough main-icon"></i>*@
                        <h3>@item.AdviceCategoryname</h3>
                        <p>@item.AdviceCategoryname</p>
                        <div class="view-more">
                            <a asp-action="ShowAdvices" asp-controller="home" asp-route-id="@item.Id">
                                View More
                                <i class="bx bx-right-arrow-alt"></i>
                            </a>
                        </div>
                    </div>
                </div>

            }
        
                 
           
        </div>
    </div>
</div>
