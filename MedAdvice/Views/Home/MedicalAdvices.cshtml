@model List<Advice>

<div class="page-banner-area bg-2">
    <div class="d-table">
        <div class="d-table-cell">
            <div class="container">
                <div class="page-content">
                    <h2>Medical Advices</h2>
                    <ul>
                        <li><a href="index.html">Home</a></li>
                        <li>Services</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="services-area ptb-100">
    <div class="container">
        <div class="section-title-one">
            <span>Our Advices</span>
            <h2>Our special Advices for all Medical conditions.</h2>
        </div>
       
            <form asp-controller="home" asp-action="ViewAdviceDetails" >
                <div class="row">
                    @foreach (var item in Model)
                    {
                        <div class="col-lg-4 col-sm-6">
                            <div class="service-card">
                                <i class="bx bx-strikethrough main-icon"></i>

                                <h3>@item.AdviceTitle</h3>

                                <small>@item.AdviceDate</small>
                                <small>@item.AdviceCategory.AdviceCategoryname</small>
                                <p>@item.AdviceBriefText</p>
                                <div class="view-more">
                                    <a href="/home/ViewAdviceDetails/@item.Id" class="btn btn-primary text-white" id="linkshowdetail">
                                        View More
                                        <i class="bx bx-right-arrow-alt"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    }

                </div>
                
            </form>
            
           

            <div class="col-lg-12 col-md-12">
                <ul class="pagination">
                    <li class="page-item">
                        <a class="page-link" href="#" aria-label="Previous">
                            <span aria-hidden="true">«</span>
                        </a>
                    </li>
                    <li class="page-item active"><a class="page-link" href="#">1</a></li>
                    <li class="page-item"><a class="page-link" href="#">2</a></li>
                    <li class="page-item"><a class="page-link" href="#">3</a></li>
                    <li class="page-item">
                        <a class="page-link" href="#" aria-label="Next">
                            <span aria-hidden="true">»</span>
                        </a>
                    </li>
                </ul>
            </div>
       
    </div>
</div>


