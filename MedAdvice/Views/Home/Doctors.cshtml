@model List<Doctor>
<div class="page-banner-area bg-5">
    <div class="d-table">
        <div class="d-table-cell">
            <div class="container">
                <div class="page-content">
                    <h2>Doctors</h2>
                    <ul>
                        <li><a href="index.html">Home</a></li>
                        <li>Doctors</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="doctors-area bg-f6f4ff ptb-100">
    <div class="container">
        <div class="section-title-one">
            <h2>Let's check-out our special doctors and their acitvity</h2>
        </div>
        <div class="row">
            @foreach (var item in Model)
            {
                <div class="col-lg-4 col-sm-6">
                    <div class="doctors-card">
                        <a asp-controller="home" asp-action="DoctorDetails" asp-route-id="@item.Id">
                            <img src=@($"data:img/jpeg;base64,{Convert.ToBase64String(item.DrProfileImage)}") alt="Image">

                        </a>
                        
                        <div class="d-table">
                            <div class="d-table-cell">
                                <div class="caption">
                                    <div class="caption-text">
                                        <h3><a asp-controller="home" asp-action="DoctorDetails" asp-route-id="@item.Id">@item.FirstName- @item.FamillyName</a></h3>
                                        <p>@item.DrSpaciality.SpacialityTitle</p>
                                        <a href="mailto: info@covax.com"> @item.EmailAdress</a>
                                        <ul>
                                            <li>
                                                <a href="#" target="_blank">
                                                    <i class="bx bxl-facebook"></i>
                                                </a>
                                            </li>
                                            <li>
                                                <a href="#" target="_blank">
                                                    <i class="bx bxl-twitter"></i>
                                                </a>
                                            </li>
                                            <li>
                                                <a href="#" target="_blank">
                                                    <i class="bx bxl-instagram"></i>
                                                </a>
                                            </li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            }
           
            <div class="col-lg-12 col-md-12">
                <ul class="pagination">
                    <li class="page-item">
                        <a class="page-link" href="#" aria-label="Previous">
                            <span aria-hidden="true">«</span>
                        </a>
                    </li>
                    <li class="page-item active"><a class="page-link" href="#">1</a></li>
                    <li class="page-item"><a class="page-link" href="#">2</a></li>
                    <li class="page-item"><a class="page-link" href="#">3</a></li>
                    <li class="page-item">
                        <a class="page-link" href="#" aria-label="Next">
                            <span aria-hidden="true">»</span>
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>