@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
    var statusCode = ViewData["StatusCode"] as int?;
}

<div class="page-title-area item-bg3">
    <div class="container">
        <h1>@(statusCode == 404 ? "Page not found" : "Something went wrong")</h1>
    </div>
</div>

<section class="ptb-100">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8 text-center">
                @if (statusCode == 404)
                {
                    <h2>404</h2>
                    <p>We could not find the page you were looking for. It may have been moved or removed.</p>
                }
                else if (statusCode != null)
                {
                    <h2>@statusCode</h2>
                    <p>The request could not be completed.</p>
                }
                else
                {
                    <p>An unexpected error occurred while processing your request. Please try again.</p>
                }

                <a asp-controller="home" asp-action="home" class="btn default-btn">Back to homepage</a>

                @if (Model != null && Model.ShowRequestId)
                {
                    <p class="mt-4">
                        <small>Reference: <code>@Model.RequestId</code></small>
                    </p>
                }
            </div>
        </div>
    </div>
</section>
