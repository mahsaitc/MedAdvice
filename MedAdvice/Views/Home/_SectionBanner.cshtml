@model MedAdvice.viewmodel.HomepageViewModel
<div class="banner-area bg-color ptb-100">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-7">
                <div class="banner-text">
                    <span>@(string.IsNullOrWhiteSpace(Model.Content.HeroTagline) ? "Explore us" : Model.Content.HeroTagline)</span>
                    <h1>@(string.IsNullOrWhiteSpace(Model.Content.HeroTitle) ? "Our doctors have different advices for every conditions" : Model.Content.HeroTitle)</h1>
                    <p>@(string.IsNullOrWhiteSpace(Model.Content.HeroText) ? "We want a happy and healthy life for you." : Model.Content.HeroText)</p>
                    <div class="search-form">
                        <form>
                            <div class="form-group">
                                <div class="row align-items-center">
                                    <div class="col-lg-3 col-md-6">
                                        <select class="form-control b-right">
                                            <option>Specialist</option>
                                            <option>Cardiologists</option>
                                            <option>Dermatologists</option>
                                            <option>Endocrinologists</option>
                                            <option>Allergists</option>
                                        </select>
                                    </div>
                                    <div class="col-lg-3 col-md-6">
                                        <select class="form-control b-right">
                                            <option>Category</option>
                                            <option>Dental Care</option>
                                            <option>Cardiology</option>
                                            <option>Neurology</option>
                                            <option>Medicine</option>
                                        </select>
                                    </div>
                                    <div class="col-lg-3">
                                        <select class="form-control">
                                            <option>Condition</option>
                                            <option>Emergency</option>
                                            <option>Mid level</option>
                                        </select>
                                    </div>
                                    <div class="col-lg-3">
                                        <div class="text-btn">
                                            <button type="submit" class="btn default-btn">Search</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
            <div class="col-lg-5">
                <div class="banner-img">
                    <div class="shape-1">
                        <img src="/layout/img/shapes/shape-1.png" alt="Shape">
                    </div>
                    <div class="shape-2">
                        <img src="/layout/img/shapes/shape-2.png" alt="Shape">
                    </div>
                    <div class="image-1">
                        @if (Model.Content.HeroImage != null && Model.Content.HeroImage.Length > 0)
                        {
                            <img src="@($"data:image/jpeg;base64,{Convert.ToBase64String(Model.Content.HeroImage)}")" alt="Image">
                        }
                        else
                        {
                            <img src="/layout/img/banner/banner-1.jpg" alt="Image">
                        }
                    </div>
                    <div class="image-2">
                        <img src="/layout/img/banner/banner-2.jpg" alt="Image">
                    </div>
                    <div class="image-3">
                        <img src="/layout/img/banner/banner-3.jpg" alt="Image">
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
