
@model ResetPasswordBySmsViewModel


<div class="sign-in-area ptb-100">
    <div class="container">
        <div class="section-title-one">
            <h2>Please enter your new password!</h2>

        </div>
        <div class="sign-in-form">
            <form asp-action="ResetPasswordByPhoneNumberLevelTwo" asp-controller="account" method="post">
                <div class="form-group">
                    <input type="password" class="form-control" asp-for="password" placeholder="password">
                    <span class="required"></span>

                </div>
                <div class="form-group">
                    <input type="password" class="form-control" asp-for="repassword" placeholder="repeate password">

                    <span asp-validation-for="repassword"></span>
                </div>
                <div class="form-group">
                    <input type="password" class="form-control" asp-for="smstoken" placeholder="sent token">

                    <span asp-validation-for="smstoken"></span>
                </div>

                <div class="text-center">
                    <button type="submit" class="btn default-btn">save new password <span></span></button>
